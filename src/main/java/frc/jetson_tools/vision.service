[Unit]
Description=Nine-grid YOLO vision to NetworkTables
After=network-online.target
Wants=network-online.target
# 攝影機斷線時程式會結束再重啟；不限制重啟次數，否則連續失敗幾次後 systemd 會放棄
StartLimitIntervalSec=0

[Service]
User=zheng
WorkingDirectory=/home/zheng/tel2026/jetson_tools
# 換模型或校正檔時改這行，然後 sudo systemctl daemon-reload && sudo systemctl restart vision
# 尚無 camera_calib.yaml：用 --hfov 針孔近似（對準時目標在畫面中央，誤差可忽略）。
# 攝影機用 /dev/v4l/by-id 固定路徑，USB 重新連線後 video 編號會變（2026-11-14 從 video0 跳到 video1）。
# 目前用 Limelight 2 當網路攝影機（2026-11-14 實測串流 640x480、15 fps，port 5802）。
# 換 USB 攝影機時：ls -l /dev/v4l/by-id/ 找 -video-index0 那個。
# 換回 Arducam OV9281（黑白；約每 10 秒 USB 斷線一次）：
#   --device /dev/v4l/by-id/usb-Arducam_Technology_Co.__Ltd._Arducam_OV9281_USB_Camera_UC762-video-index0 --exposure lock --wb auto
# 換回 jsing wb1 webcam：--device /dev/v4l/by-id/usb-WCM_USB_WEB_CAM-video-index0 --width 640 --height 480 --exposure auto --wb auto
#   （它沒有曝光／白平衡控制，720p 跑不到 30 fps）
# Limelight 2 注意：IP 要從預設 .11 改成 .12（避免和 Jetson 衝突）；綠色補光 LED 要關；
#   hfov 59.6 是 Limelight 2 規格值，請再確認；曝光在 Limelight 網頁 http://10.71.30.12:5801 設。
# 有校正檔後加上 --calib /home/zheng/tel2026/jetson_tools/camera_calib.yaml
ExecStart=/home/zheng/yolo-env/bin/python /home/zheng/tel2026/jetson_tools/vision_nt_publisher.py --model /home/zheng/tel2026/models/best.engine --team 7130 --device http://10.71.30.12:5802/ --hfov 59.6 --exposure auto --wb auto
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
